# 环境变量示例
#
# 全部都是可选的——不设任何环境变量，程序会读 config.json（首次启动自动生成）。
#
# 环境变量的用途是"不想把密钥写进文件"的场合，主要是两种：
#   1. 部署到云服务器（用 systemd 的 EnvironmentFile，密钥不落在项目目录里）
#   2. 用 Docker 跑（用 -e 或 env_file 注入）
#
# 用法（Linux/macOS）：
#   export DEEPSEEK_API_KEY=sk-xxxx
#   export BARK_KEY=你的key
#   node src/server.js
#
# 用法（Windows PowerShell）：
#   $env:DEEPSEEK_API_KEY = "sk-xxxx"
#   node src/server.js
#
# ⚠️ 别把这个文件改名成 .env 然后提交上去。真正的密钥写在这里等于公开。

# ---------------------------------------------------------------- 必填

# DeepSeek API Key。在 https://platform.deepseek.com 申请。
DEEPSEEK_API_KEY=

# Bark Key。iPhone 装 Bark App，首页那串就是。
# 不填的话聊天照常，只是不会推送到手机。
BARK_KEY=

# ---------------------------------------------------------------- 服务

# 监听端口，默认 8787
FRIEND_PORT=8787

# 监听地址。默认 0.0.0.0（局域网可访问）。
# 只给本机用填 127.0.0.1；配合反向代理时也建议填 127.0.0.1。
FRIEND_HOST=0.0.0.0

# 访问口令。不填则首次启动自动生成，写进 config.json。
# 云端部署建议显式设一个，方便在手机上输入。
FRIEND_ACCESS_TOKEN=

# ---------------------------------------------------------------- 模型

# 换 API 网关时用。默认官方地址。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 聊天模型。
# deepseek-chat 和 deepseek-flash 实测**都支持图片输入**（发图、截图它都看得懂）。
FRIEND_CHAT_MODEL=deepseek-chat

# 后台杂活用的模型（抽取记忆、压缩摘要、判断要不要主动开口、给表情包写描述）。
# 给表情包写描述那一步需要识图，所以这个模型也必须能看图。
FRIEND_UTILITY_MODEL=deepseek-chat

# 温度。越高越跳脱，越低越稳。默认 1.15
FRIEND_TEMPERATURE=1.15

# 单次回复的最大 token。想让它说话更短就调小，比如 300。
FRIEND_MAX_TOKENS=800

# ---------------------------------------------------------------- 主动消息

# 总开关。设成 false 就是纯被动，只有你说话它才回。
FRIEND_PROACTIVE=true

# 静默时段（本地时间，小时）。这段时间内绝不打扰。
FRIEND_QUIET_START=22
FRIEND_QUIET_END=7

# 两次主动消息之间的最小/最大间隔（分钟），每次在这个区间里随机。
FRIEND_MIN_GAP=45
FRIEND_MAX_GAP=120

# 你刚说完话之后，至少隔多少分钟才允许主动开口。
FRIEND_MIN_IDLE=15

# 每天最多主动几次（硬上限，防止某天刷屏）。
FRIEND_MAX_PER_DAY=12

# 你没回它时，最多连续主动几条，之后强制安静。
FRIEND_MAX_UNANSWERED=3

# 到点之后，让不让模型自己判断"现在该不该开口"。
# true = 更自然（会挑时机，也会选择不说）；false = 到点必发，会像闹钟。
FRIEND_LET_MODEL_DECIDE=true

# ---------------------------------------------------------------- 它自己的生活

# 总开关。关掉的话它就不会在你安静的时候"过日子"，生活流水不再增长。
FRIEND_LIFE=true

# 你安静多久之后它才"过日子"——正在聊天时突然有经历叫打断，不叫生活。
FRIEND_LIFE_MIN_IDLE=60

# 两次经历之间的最小间隔（分钟）
FRIEND_LIFE_MIN_GAP=120

# 超过这个间隔就一定让它经历点什么（分钟）
FRIEND_LIFE_MAX_GAP=240

# ---------------------------------------------------------------- 它的成长

# 总开关。关掉的话 self.md（它对自己的看法）永远停在当前内容，不再变化。
FRIEND_SELF=true

# 它自己过了几段日子之后，去看一眼"这些经历有没有让它对自己有新的认识"。
# 注意这是**按经历**触发，不是按时间——没发生什么的话，聊再多它也不变。
FRIEND_SELF_AFTER_EXPERIENCES=6

# 或者你们聊了多少条新消息之后去看一眼
FRIEND_SELF_AFTER_MESSAGES=12

# 单次最多改几行。超过就整次拒绝——一次换一个人不叫成长。
FRIEND_SELF_MAX_LINES=3

# ---------------------------------------------------------------- 表情包

# 总开关。关掉的话表情包清单不进提示词，它就不会发表情包了。
FRIEND_STICKER=true

# 两次表情包之间至少隔多少条**它的**消息。
# 这是最重要的一个参数：不拦的话模型会越用越多，几天后变成表情包机器人。
FRIEND_STICKER_MIN_GAP=6

# 每天最多几张（硬上限）
FRIEND_STICKER_MAX_PER_DAY=8

# ---------------------------------------------------------------- 时间与天气

# 总开关。关掉就完全不查天气。
# 注意：关掉之后"现在算白天还是晚上"会退回保守的小时分段判断，
# 不如真实日出日落准（冬天傍晚可能说错）。
FRIEND_WEATHER=true

# 你在哪。数据源 Open-Meteo，免费、不需要 API Key。
# 默认上海。换成你的经纬度即可，例如北京 39.9042 / 116.4074。
# 用经纬度而不是城市名：城市名要再过一次"地名转坐标"的接口，
# 多一个接口就多一个失败点，而这个位置根本不会变。
FRIEND_LATITUDE=31.2304
FRIEND_LONGITUDE=121.4737

# 说明：天气**只在她主动开口时**给她知道，聊天回复里永远不带。
# 这是刻意的——每句话都挂一句"今天 26 度挺舒服"，她就成天气播报员了。
# 农历、节假日、调休是内置数据（国务院公布的官方安排），不联网、不用配置。
# 想看"她眼里的现在"长什么样：node src/cli.js now
# 想看"她这轮到底知道什么"：node src/cli.js doctor

# ---------------------------------------------------------------- 主动回访

# 总开关。关掉之后她不会主动回头问你以前提过的事。
# 开着的时候：聊天里出现"有下文没下文"的事（等面试结果、在纠结一个决定），
# 会自动记进 data/recall.json，过几天进她主动开口的候选话题。
# 这就是"记忆第一次变成主动行为"——一个真朋友会隔几天回头问一句。
FRIEND_RECALL=true

# 默认隔几天回访。太短像查岗，太长就不像"还记得"。
# 具体每件事的天数由模型按性质判断（等结果 2-3 天、纠结决定 5-7 天），
# 这个只是模型没给天数时的兜底。
FRIEND_RECALL_AFTER_DAYS=3

# ---------------------------------------------------------------- 推送

# 自建 Bark 服务端时改这里。默认官方。
BARK_SERVER=https://api.day.app

# 推送分组名。留空则自动用人设里的角色名。
BARK_GROUP=

# 提示音。Bark 内置音效名，或 default。
BARK_SOUND=default

# ---------------------------------------------------------------- 上下文

# 每次带给模型多少条最近消息。调大更连贯，但更贵。
FRIEND_RECENT_MESSAGES=40

# 每积累多少条消息抽取一次长期记忆。
FRIEND_MEMORY_EVERY=24

# ---------------------------------------------------------------- 数据目录

# 数据存放位置。默认是项目下的 data/。
# 想放到别处（比如更大的盘、或者 Docker 挂载卷）就设这个。
# 测试也会用它来隔离数据，避免污染真实记录。
FRIEND_DATA_DIR=

# ---------------------------------------------------------------- 仅测试用

# 设成 1 则物理上禁止推送。测试环境用它，避免测试跑一次就响一次手机。
FRIEND_NO_PUSH=
